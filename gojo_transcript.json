[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "おはよう",
    "emotion": "调皮"
  },
  {
    "start": 4.0,
    "end": 8.0,
    "text": "人の心配してる場合じゃないよ 板取り優二",
    "emotion": "平静"
  },
  {
    "start": 9.0,
    "end": 13.0,
    "text": "君の一口刑が決定した",
    "emotion": "平静"
  },
  {
    "start": 13.0,
    "end": 17.0,
    "text": "マジで受けるね 夜の散歩かな",
    "emotion": "调皮"
  },
  {
    "start": 17.0,
    "end": 19.0,
    "text": "今どういう状況",
    "emotion": "平静"
  },
  {
    "start": 19.0,
    "end": 21.0,
    "text": "いやボロボロだね",
    "emotion": "调皮"
  },
  {
    "start": 21.0,
    "end": 23.0,
    "text": "二年のみんなに見せよ",
    "emotion": "调皮"
  },
  {
    "start": 23.0,
    "end": 26.0,
    "text": "マジ?",
    "emotion": "疑惑"
  },
  {
    "start": 26.0,
    "end": 28.0,
    "text": "マジ?",
    "emotion": "愤怒"
  },
  {
    "start": 30.0,
    "end": 33.0,
    "text": "本当だマジってるよ 受ける",
    "emotion": "调皮"
  },
  {
    "start": 34.0,
    "end": 37.0,
    "text": "体に異常は少なと変われるかい?",
    "emotion": "温柔"
  },
  {
    "start": 37.0,
    "end": 41.0,
    "text": "じゃあ十秒だ 十秒経ったら戻っておいで",
    "emotion": "自信"
  },
  {
    "start": 41.0,
    "end": 45.0,
    "text": "大丈夫 僕最強だから",
    "emotion": "自信"
  },
  {
    "start": 45.0,
    "end": 49.0,
    "text": "デートの前なんでね タッコつけさせてもらうよ",
    "emotion": "调皮"
  },
  {
    "start": 50.0,
    "end": 52.0,
    "text": "子供は送り届けたよ",
    "emotion": "调皮"
  },
  {
    "start": 53.0,
    "end": 55.0,
    "text": "今度こそ飯行こうか",
    "emotion": "开心"
  },
  {
    "start": 55.0,
    "end": 57.0,
    "text": "マックスなさい!",
    "emotion": "调皮"
  },
  {
    "start": 57.0,
    "end": 59.0,
    "text": "めぐみは?",
    "emotion": "调皮"
  },
  {
    "start": 62.0,
    "end": 64.0,
    "text": "じゃあ行こうか",
    "emotion": "调皮"
  },
  {
    "start": 65.0,
    "end": 67.0,
    "text": "犯人探しも面倒だ",
    "emotion": "愤怒"
  },
  {
    "start": 68.0,
    "end": 71.0,
    "text": "一緒のこと上の連中",
    "emotion": "愤怒"
  },
  {
    "start": 72.0,
    "end": 75.0,
    "text": "全員殺してしまおうか",
    "emotion": "愤怒"
  },
  {
    "start": 75.0,
    "end": 79.0,
    "text": "いいよ たまには先についててあげよう",
    "emotion": "平静"
  },
  {
    "start": 83.0,
    "end": 84.0,
    "text": "止まって",
    "emotion": "平静"
  },
  {
    "start": 84.0,
    "end": 85.0,
    "text": "先行ってて",
    "emotion": "嘲讽"
  },
  {
    "start": 85.0,
    "end": 87.0,
    "text": "僕をなんだと思ってるの",
    "emotion": "平静"
  },
  {
    "start": 87.0,
    "end": 88.0,
    "text": "さて",
    "emotion": "平静"
  },
  {
    "start": 89.0,
    "end": 91.0,
    "text": "君 何者?",
    "emotion": "疑惑"
  },
  {
    "start": 91.0,
    "end": 95.0,
    "text": "特急はさ 特別だから特急なわけ",
    "emotion": "平静"
  },
  {
    "start": 95.0,
    "end": 99.0,
    "text": "こうもほいほい出てこられると 調子くるっちゃうよ",
    "emotion": "嘲讽"
  },
  {
    "start": 99.0,
    "end": 100.0,
    "text": "いや",
    "emotion": "自信"
  },
  {
    "start": 101.0,
    "end": 103.0,
    "text": "楽しくなってきた",
    "emotion": "激动"
  },
  {
    "start": 105.0,
    "end": 108.0,
    "text": "まぁ 僕を狙ってきたのは確かだね",
    "emotion": "嘲讽"
  },
  {
    "start": 108.0,
    "end": 112.0,
    "text": "危機感の結状ね 当たるとどうなんの?",
    "emotion": "嘲讽"
  },
  {
    "start": 112.0,
    "end": 114.0,
    "text": "この下り",
    "emotion": "自信"
  },
  {
    "start": 114.0,
    "end": 116.0,
    "text": "さっきやったよね",
    "emotion": "嘲讽"
  },
  {
    "start": 116.0,
    "end": 118.0,
    "text": "学習しろよ ケム",
    "emotion": "嘲讽"
  },
  {
    "start": 119.0,
    "end": 122.0,
    "text": "簡単に言うと 当たってない",
    "emotion": "嘲讽"
  },
  {
    "start": 123.0,
    "end": 127.0,
    "text": "君が触れたのは 僕との間にあった無限だよ",
    "emotion": "平静"
  },
  {
    "start": 128.0,
    "end": 130.0,
    "text": "教えてあげる",
    "emotion": "平静"
  },
  {
    "start": 130.0,
    "end": 132.0,
    "text": "手 出して",
    "emotion": "调皮"
  },
  {
    "start": 134.0,
    "end": 136.0,
    "text": "ほらほら",
    "emotion": "调皮"
  },
  {
    "start": 137.0,
    "end": 138.0,
    "text": "ほらほら",
    "emotion": "调皮"
  },
  {
    "start": 138.0,
    "end": 139.0,
    "text": "ほら",
    "emotion": "调皮"
  },
  {
    "start": 140.0,
    "end": 144.0,
    "text": "ね 僕はこのまま悪手してもいいんだけど",
    "emotion": "嘲讽"
  },
  {
    "start": 144.0,
    "end": 146.0,
    "text": "照れるなよ",
    "emotion": "嘲讽"
  },
  {
    "start": 146.0,
    "end": 148.0,
    "text": "こっちまで恥ずかしくなる",
    "emotion": "嘲讽"
  },
  {
    "start": 148.0,
    "end": 150.0,
    "text": "大丈夫でしょ",
    "emotion": "嘲讽"
  },
  {
    "start": 150.0,
    "end": 153.0,
    "text": "だって君 弱いもん",
    "emotion": "嘲讽"
  },
  {
    "start": 155.0,
    "end": 157.0,
    "text": "領域展開",
    "emotion": "认真"
  },
  {
    "start": 160.0,
    "end": 162.0,
    "text": "無料空所",
    "emotion": "认真"
  },
  {
    "start": 162.0,
    "end": 164.0,
    "text": "お花だ",
    "emotion": "调皮"
  },
  {
    "start": 164.0,
    "end": 166.0,
    "text": "お花",
    "emotion": "调皮"
  },
  {
    "start": 168.0,
    "end": 170.0,
    "text": "十術だよな",
    "emotion": "平静"
  },
  {
    "start": 170.0,
    "end": 171.0,
    "text": "せいがそがれる",
    "emotion": "平静"
  },
  {
    "start": 171.0,
    "end": 173.0,
    "text": "花からうやまうきがねえんだよ",
    "emotion": "嘲讽"
  },
  {
    "start": 173.0,
    "end": 177.0,
    "text": "最近の老人は 主語がでかくてまえるよほんと",
    "emotion": "平静"
  },
  {
    "start": 177.0,
    "end": 179.0,
    "text": "僕だけだと思ってんだら",
    "emotion": "愤怒"
  },
  {
    "start": 179.0,
    "end": 182.0,
    "text": "痛い目見るよ オジイちゃん",
    "emotion": "嘲讽"
  },
  {
    "start": 182.0,
    "end": 184.0,
    "text": "怖い",
    "emotion": "调皮"
  },
  {
    "start": 184.0,
    "end": 187.0,
    "text": "痛いこと言ったから 配算しよっと",
    "emotion": "调皮"
  },
  {
    "start": 188.0,
    "end": 190.0,
    "text": "どういたしまして",
    "emotion": "调皮"
  },
  {
    "start": 190.0,
    "end": 192.0,
    "text": "なぁなみん お出かけしよ",
    "emotion": "调皮"
  },
  {
    "start": 192.0,
    "end": 194.0,
    "text": "え 遠慮します",
    "emotion": "平静"
  },
  {
    "start": 194.0,
    "end": 197.0,
    "text": "いや マジで 大事な話があるんだって",
    "emotion": "调皮"
  },
  {
    "start": 197.0,
    "end": 198.0,
    "text": "それは大変だ",
    "emotion": "平静"
  },
  {
    "start": 198.0,
    "end": 200.0,
    "text": "まだ何も言ってないよ",
    "emotion": "调皮"
  },
  {
    "start": 209.0,
    "end": 211.0,
    "text": "ぶっからっと",
    "emotion": "调皮"
  },
  {
    "start": 211.0,
    "end": 212.0,
    "text": "こんばんは",
    "emotion": "调皮"
  },
  {
    "start": 212.0,
    "end": 215.0,
    "text": "ふぎたぎのバラティース",
    "emotion": "调皮"
  },
  {
    "start": 218.0,
    "end": 220.0,
    "text": "なおのみん",
    "emotion": "调皮"
  },
  {
    "start": 220.0,
    "end": 222.0,
    "text": "おもしろい話して",
    "emotion": "调皮"
  },
  {
    "start": 224.0,
    "end": 226.0,
    "text": "よし わかった",
    "emotion": "调皮"
  },
  {
    "start": 226.0,
    "end": 229.0,
    "text": "じゃあ 廃棄のおにぎりでキャッチボールしながら",
    "emotion": "调皮"
  },
  {
    "start": 229.0,
    "end": 232.0,
    "text": "成長分離について勝たろうぜ",
    "emotion": "调皮"
  },
  {
    "start": 232.0,
    "end": 234.0,
    "text": "動画あげて 延長しようぜ",
    "emotion": "平静"
  },
  {
    "start": 236.0,
    "end": 238.0,
    "text": "お一人でどうぞ",
    "emotion": "平静"
  },
  {
    "start": 238.0,
    "end": 240.0,
    "text": "何がわかったんだか",
    "emotion": "平静"
  },
  {
    "start": 242.0,
    "end": 244.0,
    "text": "五条サトルの大好きなところで",
    "emotion": "调皮"
  },
  {
    "start": 244.0,
    "end": 246.0,
    "text": "山の出せんゲーム",
    "emotion": "调皮"
  },
  {
    "start": 247.0,
    "end": 249.0,
    "text": "全部",
    "emotion": "开心"
  },
  {
    "start": 249.0,
    "end": 252.0,
    "text": "せっせー 俺 何したらいい?",
    "emotion": "平静"
  },
  {
    "start": 252.0,
    "end": 254.0,
    "text": "何もしなくていい",
    "emotion": "温柔"
  },
  {
    "start": 254.0,
    "end": 256.0,
    "text": "僕の言う通りにしろ",
    "emotion": "调皮"
  },
  {
    "start": 256.0,
    "end": 257.0,
    "text": "流れるままに",
    "emotion": "调皮"
  },
  {
    "start": 257.0,
    "end": 259.0,
    "text": "だから 何したらいい?",
    "emotion": "平静"
  },
  {
    "start": 259.0,
    "end": 261.0,
    "text": "おんまた",
    "emotion": "调皮"
  },
  {
    "start": 262.0,
    "end": 264.0,
    "text": "五条サトル",
    "emotion": "平静"
  },
  {
    "start": 265.0,
    "end": 267.0,
    "text": "いやー 皆さんおそろいで",
    "emotion": "调皮"
  },
  {
    "start": 267.0,
    "end": 270.0,
    "text": "私 出張で海外に行ってましたね",
    "emotion": "调皮"
  },
  {
    "start": 270.0,
    "end": 272.0,
    "text": "これから お土産を配りたいと思います",
    "emotion": "调皮"
  },
  {
    "start": 273.0,
    "end": 275.0,
    "text": "東京のみんなには こちら",
    "emotion": "调皮"
  },
  {
    "start": 276.0,
    "end": 278.0,
    "text": "個人の板取り ゆうじくんです",
    "emotion": "调皮"
  },
  {
    "start": 280.0,
    "end": 282.0,
    "text": "はい 京都のみなさん",
    "emotion": "调皮"
  },
  {
    "start": 282.0,
    "end": 285.0,
    "text": "俺が少なのうつは 板取りゆうじくんですよ",
    "emotion": "调皮"
  },
  {
    "start": 286.0,
    "end": 288.0,
    "text": "京都の人らは",
    "emotion": "调皮"
  },
  {
    "start": 288.0,
    "end": 290.0,
    "text": "お土産に無茶!",
    "emotion": "调皮"
  },
  {
    "start": 291.0,
    "end": 293.0,
    "text": "学願寺学長",
    "emotion": "平静"
  },
  {
    "start": 293.0,
    "end": 296.0,
    "text": "いやー 良かった 良かった",
    "emotion": "嘲讽"
  },
  {
    "start": 296.0,
    "end": 299.0,
    "text": "びっくりして死んじゃったらどうしようかと",
    "emotion": "嘲讽"
  },
  {
    "start": 299.0,
    "end": 301.0,
    "text": "心配しましたよ",
    "emotion": "嘲讽"
  },
  {
    "start": 303.0,
    "end": 305.0,
    "text": "くそがきる",
    "emotion": "愤怒"
  },
  {
    "start": 309.0,
    "end": 311.0,
    "text": "ほら おじいちゃん",
    "emotion": "调皮"
  },
  {
    "start": 311.0,
    "end": 313.0,
    "text": "散歩の時間ですよ",
    "emotion": "嘲讽"
  },
  {
    "start": 313.0,
    "end": 315.0,
    "text": "昼ごはんは さっき食べたでしょう",
    "emotion": "嘲讽"
  },
  {
    "start": 316.0,
    "end": 318.0,
    "text": "残るはあいつか",
    "emotion": "认真"
  },
  {
    "start": 318.0,
    "end": 320.0,
    "text": "あれも 逃げがうまい",
    "emotion": "平静"
  },
  {
    "start": 321.0,
    "end": 324.0,
    "text": "ゆうじのところまで 距離があるな",
    "emotion": "平静"
  },
  {
    "start": 324.0,
    "end": 326.0,
    "text": "しかたない",
    "emotion": "平静"
  },
  {
    "start": 326.0,
    "end": 329.0,
    "text": "少し 乱暴しようか",
    "emotion": "认真"
  },
  {
    "start": 329.0,
    "end": 332.0,
    "text": "実式順点 青",
    "emotion": "认真"
  },
  {
    "start": 332.0,
    "end": 335.0,
    "text": "実式反転 赤",
    "emotion": "认真"
  },
  {
    "start": 340.0,
    "end": 342.0,
    "text": "きょすき",
    "emotion": "认真"
  },
  {
    "start": 345.0,
    "end": 347.0,
    "text": "むらたき",
    "emotion": "认真"
  },
  {
    "start": 353.0,
    "end": 355.0,
    "text": "いえーい",
    "emotion": "调皮"
  },
  {
    "start": 355.0,
    "end": 357.0,
    "text": "いっけんなくざく",
    "emotion": "调皮"
  },
  {
    "start": 360.0,
    "end": 363.0,
    "text": "おまえはまず ゴジウをどうにかしろ",
    "emotion": "平静"
  },
  {
    "start": 363.0,
    "end": 365.0,
    "text": "うっ",
    "emotion": "平静"
  },
  {
    "start": 367.0,
    "end": 370.0,
    "text": "はい または僕の勝ち",
    "emotion": "平静"
  },
  {
    "start": 371.0,
    "end": 373.0,
    "text": "珍しいよね",
    "emotion": "温柔"
  },
  {
    "start": 373.0,
    "end": 376.0,
    "text": "めぐみが僕に 京子を頼むなんて",
    "emotion": "温柔"
  },
  {
    "start": 376.0,
    "end": 378.0,
    "text": "ゆうじに追い越されて 焦った?",
    "emotion": "温柔"
  },
  {
    "start": 378.0,
    "end": 382.0,
    "text": "やってないんじゃなくて 出来てないんだよ",
    "emotion": "温柔"
  },
  {
    "start": 382.0,
    "end": 385.0,
    "text": "でも周りに味方が何人いようと",
    "emotion": "温柔"
  },
  {
    "start": 386.0,
    "end": 388.0,
    "text": "死ぬ時は一人だよ",
    "emotion": "平静"
  },
  {
    "start": 388.0,
    "end": 390.0,
    "text": "死んで勝った",
    "emotion": "认真"
  },
  {
    "start": 390.0,
    "end": 392.0,
    "text": "死んでも勝つ",
    "emotion": "认真"
  },
  {
    "start": 394.0,
    "end": 396.0,
    "text": "全然違うよ",
    "emotion": "认真"
  },
  {
    "start": 396.0,
    "end": 398.0,
    "text": "めぐみ",
    "emotion": "温柔"
  },
  {
    "start": 400.0,
    "end": 402.0,
    "text": "気やすく触らないでもらえるかしら",
    "emotion": "调皮"
  },
  {
    "start": 402.0,
    "end": 404.0,
    "text": "どれも猫だったし",
    "emotion": "调皮"
  },
  {
    "start": 404.0,
    "end": 407.0,
    "text": "めぐみちゃんはこれから私と一緒に",
    "emotion": "调皮"
  },
  {
    "start": 407.0,
    "end": 410.0,
    "text": "バイオリンのお稽古なのよ",
    "emotion": "调皮"
  },
  {
    "start": 410.0,
    "end": 412.0,
    "text": "帰るわよ",
    "emotion": "调皮"
  },
  {
    "start": 412.0,
    "end": 413.0,
    "text": "めぐみちゃん",
    "emotion": "调皮"
  },
  {
    "start": 413.0,
    "end": 417.0,
    "text": "今日こそキラキラ星をマッサーしてもらうわ",
    "emotion": "调皮"
  },
  {
    "start": 417.0,
    "end": 420.0,
    "text": "大丈夫 気にせず行ってください",
    "emotion": "温柔"
  },
  {
    "start": 420.0,
    "end": 422.0,
    "text": "でましでなんすか",
    "emotion": "平静"
  },
  {
    "start": 422.0,
