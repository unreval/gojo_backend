# 复制为本目录的 .env 后再填。deploy/.env 已被 git 忽略，不要提交。
# 不要把填好的文件贴进对话。
#
# 下面的值是代码默认或占位符，不是 Zeabur 上的生产值。
# 迁过去之前按生产实际值改。漏一个开关，线上会静默换成默认。
#
# 布尔值不要留空：
# - 有的变量把空字符串当成开启（COGNITIVE_WORKER_ENABLED、SHADOW_AUDIT_ENABLED）。
# - 有的变量把空字符串当成关闭（CANDIDATE_PRODUCER_ENABLED）。
# 需要整数的项如果留空，进程会在启动时直接报错（认知便利贴 TTL）。
# 不需要覆盖的整数项，整行不要写。
#
# 数据库会话时区由 gojo_backend/db.py 固定为 UTC。
# compose 里的 TZ=Asia/Shanghai 只影响容器日志时钟，不要改 db.py。

# --- 数据库（必填）---
# 应用只通过 compose 服务名 db 连接。不要写成公网地址，不要为了本机调试去映射 5432。
# 密码若含有 @ : / # ? &，只在这一行做 URL 编码，POSTGRES_PASSWORD 仍写原始密码。
POSTGRES_USER=gojo
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=gojo
DATABASE_URL=postgresql://gojo:REPLACE_ME@db:5432/gojo

# --- 站点（必填）---
# 换成你自己的域名。Caddy 用它申请证书。必须和下面的 PORT 一起看：
# Caddyfile 把这个域名转到 app:8080，所以 PORT 必须是 8080。
SITE_DOMAIN=chat.example.com
PORT=8080

# --- 模型与中转（必填）---
# 主体对话、语音、故事。旧密钥在 Zeabur 侧视为已泄露，这里填新密钥。
ANTHROPIC_KEY=REPLACE_ME
# 超时秒数。不写则 120。写了就不要留空。
ANTHROPIC_TIMEOUT_SECONDS=120
# 中转站根地址。本仓库没有单独读取它，Anthropic SDK 在创建客户端时读取。
# 直连官方时不要写出这一行：空字符串可能被 SDK 当成地址。
# ANTHROPIC_BASE_URL=https://your-relay.example
# 角色扮演主体 / 日语辅助 / 中档。不写则用代码里的模型名。
MODEL_MAIN=claude-opus-4-6
MODEL_JP_AUX=claude-haiku-4-5-20251001
MODEL_MID=claude-sonnet-4-6
# 中文辅助（记忆提取、日记、纠错）走 DeepSeek。不用就留空密钥，不要删掉变量名。
MODEL_CN_AUX=deepseek-v4-flash
DEEPSEEK_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 临时 HTTP 故障的外层尝试次数（1 到 4）和退避秒数。
PROVIDER_TRANSPORT_ATTEMPTS=2
PROVIDER_TRANSPORT_BACKOFF_SECONDS=0.4

# --- 语音（用到哪项就填哪项）---
# fish 或其它代码已支持的提供方。默认 fish。
TTS_PROVIDER=fish
FISH_KEY=REPLACE_ME
# 不写下一行则用代码内默认音色。写了就不要留空。
# FISH_VOICE_ID=your-fish-voice-id
# 语音转写。不填则转写接口报未配置。
GROQ_KEY=REPLACE_ME

# --- 对象存储（表情、图片；夜间备份也用同一套）---
# 桶可以继续用原来的。访问密钥要换新的，旧密钥作废。
# 四项缺任意一项，媒体存储视为未配置，表情包不会启用。
R2_ENDPOINT=https://REPLACE_ME.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=REPLACE_ME
R2_REGION=auto
# 签名下载链接的有效秒数。不写则 21600。
R2_SIGNED_URL_TTL_SECONDS=21600

# --- 向量（可选）---
# 0：不走向量，启动日志会出现「未启用，使用全量注入」。这不是故障。
# 1：才调用下面的 embedding 接口。向量存在 JSON 列里，不需要 pgvector。
USE_RAG=0
EMBED_API_KEY=
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_MODEL=embedding-3
EMBED_DIM=1024
RAG_CACHE_MAX=20000
RAG_AUTO_BATCH=100
RAG_AUTO_INTERVAL=60

# --- 记忆候选（容易静默关掉）---
# 代码默认 false。false 或留空：候选线程不启动，记忆候选不产生。
# 生产若是开的，必须写成 true。
CANDIDATE_PRODUCER_ENABLED=false
# 代码默认 true。true 时即使上面开了，也只记影子，不写认知事实。
# 生产若已经在真正写入，这里必须写成 false。只改上面那一项不够。
# 留空等于 true。
CANDIDATE_PRODUCER_SHADOW=true
# 只回溯最近几天。0 或负数表示不设窗口。
CANDIDATE_PRODUCER_LOOKBACK_DAYS=7
# 候选观测表。代码默认 true。留空也会变成 true。要关就写 false。
CANDIDATE_AUDIT_ENABLED=true
# 分类影子审计。代码默认 false。留空会变成 true，所以这里写明 false。
SHADOW_AUDIT_ENABLED=false

# --- 认知 worker（容易静默关掉，留空又会变成开）---
# 代码默认 false。必须写 true 或 false，不要留空。
# 留空会被当成开启。日志里 disabled by COGNITIVE_WORKER_ENABLED 就是这里没开。
COGNITIVE_WORKER_ENABLED=false
# 不写则用 MODEL_MAIN。写了就不要留空。
# COGNITIVE_WORKER_MODEL=
# 下列整数都有代码默认。不覆盖就不要写进 .env；写了必须是整数，不能留空。
# COGNITIVE_WORKER_POLL_SECONDS=5
# COGNITIVE_WORKER_MAX_TOKENS=1800
# COGNITIVE_WORKER_MODEL_ATTEMPTS=2
# COGNITIVE_WORKER_ERROR_BACKOFF_SECONDS=20
# COGNITIVE_WORKER_MAX_REQUEST_BYTES=65536
# COGNITIVE_MAX_CYCLES_PER_RUN=0
# COGNITIVE_MIN_SECONDS_BETWEEN_CYCLES=0
# COGNITIVE_COOLDOWN_SECONDS=1800
# COGNITIVE_DAILY_CYCLE_LIMIT=8
# COGNITIVE_CLAIM_LEASE_SECONDS=300
# COGNITIVE_MAX_RETRY=3
# COGNITIVE_MAX_TRIGGERS_PER_CYCLE=20
# COGNITIVE_MAX_QUESTIONS_PER_CYCLE=5
# COGNITIVE_HIGH_WEIGHT_THRESHOLD=0.8
# COGNITIVE_REACTIVATION_COSINE_THRESHOLD=0.75
# COGNITIVE_REFLECTION_SUPPRESSION_SECONDS=21600
# COGNITIVE_REFLECTION_INTERVAL_SECONDS=86400
# COGNITIVE_REFLECTION_SCAN_SECONDS=300
# COGNITIVE_REFLECTION_ACTIVE_DAYS=30
# COGNITIVE_REFLECTION_SCAN_BATCH=200
# COGNITIVE_ESTIMATED_TOKENS_PER_SLOW_CYCLE=1200
# COGNITIVE_MAX_BELIEFS_IN_CONTEXT=50
# COGNITIVE_MAX_HYPOTHESES_IN_CONTEXT=30
# COGNITIVE_MAX_PREDICTIONS_IN_CONTEXT=20
# COGNITIVE_MAX_STICKY_NOTES_IN_CONTEXT=8
# COGNITIVE_MAX_DIARY_ENTRIES_IN_CONTEXT=5
# COGNITIVE_MAX_QUESTIONS_IN_CONTEXT=20
# COGNITIVE_BELIEF_COMMIT_MIN_CONFIDENCE=0.78
# COGNITIVE_BELIEF_COMMIT_MIN_INDEPENDENT_EVIDENCE=2
# COGNITIVE_DIARY_RECALL_LIMIT=3
# COGNITIVE_SCOPE_TENDENCY_MIN_CONTEXTS=3
# COGNITIVE_SCOPE_CROSS_MIN_CONTEXTS=2
# 便利贴 TTL（秒）。非法或留空会让进程起不来。不改就保持注释。
# COGNITIVE_STICKY_NOTE_MIN_TTL_SECONDS=300
# COGNITIVE_STICKY_NOTE_DEFAULT_TTL_SECONDS=259200
# COGNITIVE_STICKY_NOTE_MAX_TTL_SECONDS=1209600

# --- 延迟回复 / 表情 / 校验开关 ---
# 代码默认开启。留空也是开启。要关就写 false。
DELAYED_REPLY_ENABLED=true
DELAYED_REPLY_MAX_PER_TICK=1
DELAYED_REPLY_MAX_PER_HOUR=20
# 只有 false 会关表情。还要清单和 R2 都在。生产若关过，写成 false。
STICKERS_ENABLED=true
STICKER_COOLDOWN_TURNS=3
STICKER_REPEAT_WINDOW=10
# 代码默认 false：翻译校验和日程措辞校验不拦截回复。生产若改过，照抄。
TRANSLATION_CHECKS_BLOCKING=false
SCHEDULE_CLAIM_CHECKS_BLOCKING=false

# --- 其它后台默认 ---
# 承诺过期宽限分钟数。
PROMISE_GRACE_MINUTES=120
# 群聊冒泡。0 关闭。
GROUP_BUBBLE=1
BUBBLE_MAX_PER_DAY=3
BUBBLE_QUIET_MIN=25
BUBBLE_MAX_IDLE_H=6
BUBBLE_CHECK_MIN=10
# 延迟日志。1 开启。
GOJO_LATENCY_LOG=1
GOJO_LATENCY_LEVEL=INFO

# --- 夜间备份脚本（只在宿主机跑 scripts/backup_db_to_r2.py 时读取）---
# compose：在 db 容器里执行 pg_dump，不把 5432 暴露到宿主机。
# pg_dump：改用宿主机的 pg_dump 和 DATABASE_URL。连接串会出现在进程列表里。
BACKUP_DUMP_MODE=compose
# 保留最近几份 db-backups/gojo_YYYYMMDD_HHMM.sql.gz。必须 >= 1。
BACKUP_KEEP_COUNT=14
# 不写则脚本自己找 deploy/.env。一般不用设。
# BACKUP_ENV_FILE=
# BACKUP_TMPDIR=
# COMPOSE_FILE=
