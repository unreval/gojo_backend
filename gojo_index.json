    {
      "start": 276.0,
      "end": 278.0,
      "text": "個人の板取り ゆうじくんです"
    },
    {
      "start": 280.0,
      "end": 282.0,
      "text": "はい 京都のみなさん"
    },
    {
      "start": 282.0,
      "end": 285.0,
      "text": "俺が少なのうつは 板取りゆうじくんですよ"
    },
    {
      "start": 286.0,
      "end": 288.0,
      "text": "京都の人らは"
    },
    {
      "start": 288.0,
      "end": 290.0,
      "text": "お土産に無茶!"
    },
    {
      "start": 309.0,
      "end": 311.0,
      "text": "ほら おじいちゃん"
    },
    {
      "start": 353.0,
      "end": 355.0,
      "text": "いえーい"
    },
    {
      "start": 355.0,
      "end": 357.0,
      "text": "いっけんなくざく"
    },
    {
      "start": 400.0,
      "end": 402.0,
      "text": "気やすく触らないでもらえるかしら"
    },
    {
      "start": 402.0,
      "end": 404.0,
      "text": "どれも猫だったし"
    },
    {
      "start": 404.0,
