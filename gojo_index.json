    },
    {
      "start": 413.0,
      "end": 417.0,
      "text": "今日こそキラキラ星をマッサーしてもらうわ"
    },
    {
      "start": 433.0,
      "end": 436.0,
      "text": "なんと霊の物の樹肉体だったの"
    }
  ],
  "平静": [
    {
